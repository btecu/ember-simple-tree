<h2>Simple Tree Demo</h2>

<blockquote>
  <Tree @model={{this.tree}} @checkable={{true}} @expandDepth={{-1}} as |node|>
    <node.Toggle @model={{node.model}} @toggleExpand={{node.toggleExpand}} />
    <node.Checkbox @model={{node.model}} @toggleCheck={{node.toggleCheck}} />
    {{node.model.name}}
  </Tree>
</blockquote>