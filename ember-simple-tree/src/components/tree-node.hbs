<div
  class={{concat
    (if @model.isDisabled "tree-disabled ")
    (if @model.isSelected "tree-highlight ")
    (if this.isChosen "tree-chosen ")
    (if @model.children.length "tree-children")
  }}
  role="button"
  {{on "click" this.click}}
  {{on "contextmenu" this.contextMenu}}
  {{on "mouseenter" this.mouseEnter}}
  {{on "mouseleave" this.mouseLeave}}
>
  {{#if (has-block)}}
    {{yield
      (hash
        model=@model
        toggleExpand=this.toggleExpand
        toggleCheck=this.toggleCheck
        Toggle=this.Toggle
        Checkbox=this.Checkbox
      )
    }}
  {{else}}
    <TreeToggle
      role="presentation"
      @model={{@model}}
      @toggleExpand={{this.toggleExpand}}
    >
      <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
      <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
    </TreeToggle>

    {{#if @checkable}}
      <TreeCheckbox
        role="presentation"
        @model={{@model}}
        @toggleCheck={{this.toggleCheck}}
      />
    {{/if}}
    <span class="tree-label">
      {{@model.name}}
    </span>
  {{/if}}
</div>