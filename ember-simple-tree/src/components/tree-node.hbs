<div
  class={{concat
    (if @model.isDisabled "tree-disabled ")
    (if @model.isSelected "tree-highlight ")
    (if this.isChosen "tree-chosen ")
    (if @model.children.length "tree-children")
  }}
  role="button"
  {{on "click" this.click}}
  {{on "contextmenu" this.contextMenu}}
  {{on "mouseenter" this.mouseEnter}}
  {{on "mouseleave" this.mouseLeave}}
>
  {{#if (has-block)}}
    {{yield
      (hash
        model=@model
        toggle=(component
          "tree-toggle"
          model=@model
          toggleExpand=this.toggleExpand
          expandedIcon=@expandedIcon
          collapsedIcon=@collapsedIcon
        )
        checkbox=(component
          "tree-checkbox" model=@model toggleCheck=this.toggleCheck
        )
      )
    }}
  {{else}}
    <TreeToggle
      role="presentation"
      @model={{@model}}
      @toggleExpand={{this.toggleExpand}}
      @expandedIcon={{@expandedIcon}}
      @collapsedIcon={{@collapsedIcon}}
    />

    {{#if @checkable}}
      <TreeCheckbox
        role="presentation"
        @model={{@model}}
        @toggleCheck={{this.toggleCheck}}
      />
    {{/if}}
    <span class="tree-label">
      {{@model.name}}
    </span>
  {{/if}}
</div>