<ul class="tree-branch">
  {{#each @model as |child|}}
    {{#if child.isVisible}}
      {{#if (has-block)}}
        <TreeChildren
          @checkable={{@checkable}}
          @recursiveCheck={{@recursiveCheck}}
          @updateCheckbox={{@updateCheckbox}}
          @chosenId={{@chosenId}}
          @onCheck={{@onCheck}}
          @onContextMenu={{@onContextMenu}}
          @onSelect={{@onSelect}}
          @onHover={{@onHover}}
          @onHoverOut={{@onHoverOut}}
          @model={{child}}
        >
          <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
          <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
          <:default as |node|>{{yield node}}</:default>
        </TreeChildren>
      {{else}}
        <TreeChildren
          @model={{child}}
          @checkable={{@checkable}}
          @recursiveCheck={{@recursiveCheck}}
          @updateCheckbox={{@updateCheckbox}}
          @chosenId={{@chosenId}}
          @onCheck={{@onCheck}}
          @onContextMenu={{@onContextMenu}}
          @onSelect={{@onSelect}}
          @onHover={{@onHover}}
          @onHoverOut={{@onHoverOut}}
        >
          <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
          <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
        </TreeChildren>
      {{/if}}
    {{/if}}
  {{/each}}
</ul>