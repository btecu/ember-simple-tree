<li class="tree-node">
  {{#if (has-block)}}
    <TreeNode
      @checkable={{@checkable}}
      @recursiveCheck={{@recursiveCheck}}
      @updateCheckbox={{this.updateCheckbox}}
      @chosenId={{@chosenId}}
      @onCheck={{@onCheck}}
      @onContextMenu={{@onContextMenu}}
      @onSelect={{@onSelect}}
      @onHover={{@onHover}}
      @onHoverOut={{@onHoverOut}}
      @model={{@model}}
    >
      <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
      <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
      <:default as |node|>{{yield node}}</:default>
    </TreeNode>

    {{#if @model.isExpanded}}
      <TreeBranch
        @checkable={{@checkable}}
        @recursiveCheck={{@recursiveCheck}}
        @updateCheckbox={{this.updateCheckbox}}
        @chosenId={{@chosenId}}
        @onCheck={{@onCheck}}
        @onContextMenu={{@onContextMenu}}
        @onSelect={{@onSelect}}
        @onHover={{@onHover}}
        @onHoverOut={{@onHoverOut}}
        @model={{@model.children}}
      >
        <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
        <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
        <:default as |node|>{{yield node}}</:default>
      </TreeBranch>
    {{/if}}
  {{else}}
    <TreeNode
      @model={{@model}}
      @checkable={{@checkable}}
      @recursiveCheck={{@recursiveCheck}}
      @updateCheckbox={{this.updateCheckbox}}
      @chosenId={{@chosenId}}
      @onCheck={{@onCheck}}
      @onContextMenu={{@onContextMenu}}
      @onSelect={{@onSelect}}
      @onHover={{@onHover}}
      @onHoverOut={{@onHoverOut}}
    >
      <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
      <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
    </TreeNode>
    {{#if @model.isExpanded}}
      <TreeBranch
        @model={{@model.children}}
        @checkable={{@checkable}}
        @recursiveCheck={{@recursiveCheck}}
        @updateCheckbox={{this.updateCheckbox}}
        @chosenId={{@chosenId}}
        @onCheck={{@onCheck}}
        @onContextMenu={{@onContextMenu}}
        @onSelect={{@onSelect}}
        @onHover={{@onHover}}
        @onHoverOut={{@onHoverOut}}
      >
        <:expandedIcon>{{yield to="expandedIcon"}}</:expandedIcon>
        <:collapsedIcon>{{yield to="collapsedIcon"}}</:collapsedIcon>
      </TreeBranch>
    {{/if}}
  {{/if}}
</li>