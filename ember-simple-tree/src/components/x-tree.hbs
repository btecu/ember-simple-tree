<div class="tree">
  {{#if (has-block)}}
    <XTreeBranch
      @checkable={{@checkable}}
      @recursiveCheck={{@recursiveCheck}}
      @chosenId={{@chosenId}}
      @onCheck={{@onCheck}}
      @onContextMenu={{@onContextMenu}}
      @onSelect={{@onSelect}}
      @onHover={{@onHover}}
      @onHoverOut={{@onHoverOut}}
      @model={{@model}}
    >
      <:expandedIcon>
        {{#if (has-block "expandedIcon")}}
          {{yield to="expandedIcon"}}
        {{else}}
          &#x25BC;
        {{/if}}
      </:expandedIcon>
      <:collapsedIcon>
        {{#if (has-block "collapsedIcon")}}
          {{yield to="collapsedIcon"}}
        {{else}}
          &#x25B6;
        {{/if}}
      </:collapsedIcon>
      <:default as |node|>
        {{yield node}}
      </:default>
    </XTreeBranch>
  {{else}}
    <XTreeBranch
      @checkable={{@checkable}}
      @recursiveCheck={{@recursiveCheck}}
      @chosenId={{@chosenId}}
      @onCheck={{@onCheck}}
      @onContextMenu={{@onContextMenu}}
      @onSelect={{@onSelect}}
      @onHover={{@onHover}}
      @onHoverOut={{@onHoverOut}}
      @model={{@model}}
    >
      <:expandedIcon>
        {{#if (has-block "expandedIcon")}}
          {{yield to="expandedIcon"}}
        {{else}}
          &#x25BC;
        {{/if}}
      </:expandedIcon>
      <:collapsedIcon>
        {{#if (has-block "collapsedIcon")}}
          {{yield to="collapsedIcon"}}
        {{else}}
          &#x25B6;
        {{/if}}
      </:collapsedIcon>
    </XTreeBranch>
  {{/if}}
</div>