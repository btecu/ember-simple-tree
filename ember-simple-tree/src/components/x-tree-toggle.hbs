<span class="tree-toggle">
  <span role="button" class="toggle-icon" {{on "click" @toggleExpand}}>
    {{#if @model.children.length}}
      {{#if @model.isExpanded}}
        {{#if (has-block "expandedIcon")}}
          {{yield to="expandedIcon"}}
        {{else}}
          &#x25BC;
        {{/if}}
      {{else}}
        {{#if (has-block "collapsedIcon")}}
          {{yield to="collapsedIcon"}}
        {{else}}
          &#x25B6;
        {{/if}}
      {{/if}}
    {{else}}
      &nbsp;
    {{/if}}
  </span>
</span>